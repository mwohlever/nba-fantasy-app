"use client";

import {
  useEffect,
  useMemo,
  useState,
} from "react";

import PlayerHeadshot from "@/components/ui/PlayerHeadshot";
import { useSelectedSport } from "@/components/providers/SportProvider";

import type {
  Player,
  TargetDraftSlot,
} from "@/components/lineups/types";

type Props = {
  targetDraftSlot: TargetDraftSlot | null;
  setTargetDraftSlot: (
    slot: TargetDraftSlot | null
  ) => void;
  players: Player[];
  playerAverageMap: Map<number, number>;
  playerProjections: Record<number, any>;
  availablePlayerIdSet: Set<number>;
  isAvailabilityLoading: boolean;
  getOwnerTeamForPlayer: (
    playerId: number
  ) => { id: number; name: string } | null;
  handleAssignPlayerToTeam: (
    player: Player,
    teamId: number
  ) => Promise<void>;
  onInspectPlayer: (player: Player) => void;
  selectedSeason: string;
  hidden?: boolean;
  isAssigningPlayer: boolean;
  isSaving: boolean;
};

type ResearchMode =
  | "season"
  | "league";

type LeagueHistoryStat = {
  player_id: number;
  times_drafted?: number | null;
  avg_score?: number | null;
  high_score?: number | null;
  winning_lineups?: number | null;
  runner_up_lineups?: number | null;
  podium_lineups?: number | null;
  avg_finish?: number | null;
};

function fmt(
  value: number | null | undefined,
  digits = 1,
) {
  if (
    value === null ||
    value === undefined ||
    !Number.isFinite(Number(value))
  ) {
    return "—";
  }

  return Number(value).toFixed(digits);
}

function pct(
  value: number | null | undefined,
  digits = 0,
) {
  if (
    value === null ||
    value === undefined ||
    !Number.isFinite(Number(value))
  ) {
    return "—";
  }

  return `${Number(value).toFixed(digits)}%`;
}

function intValue(
  value: number | null | undefined,
) {
  if (
    value === null ||
    value === undefined ||
    !Number.isFinite(Number(value))
  ) {
    return "—";
  }

  return String(
    Math.round(Number(value)),
  );
}

export default function SlotDraftModal({
  targetDraftSlot,
  setTargetDraftSlot,
  players,
  playerAverageMap,
  playerProjections,
  availablePlayerIdSet,
  isAvailabilityLoading,
  getOwnerTeamForPlayer,
  handleAssignPlayerToTeam,
  onInspectPlayer,
  selectedSeason,
  hidden = false,
  isAssigningPlayer,
  isSaving,
}: Props) {
  const { selectedSport } =
    useSelectedSport();

  const isGolf =
    selectedSport === "golf";

  const isNfl =
    selectedSport === "nfl";

  const [
    searchTerm,
    setSearchTerm,
  ] = useState("");

  const [
    showAllPlayers,
    setShowAllPlayers,
  ] = useState(false);

  const [
    researchMode,
    setResearchMode,
  ] = useState<ResearchMode>(
    "season",
  );

  const [
    seasonStats,
    setSeasonStats,
  ] = useState<any[]>([]);

  const [
    leagueHistory,
    setLeagueHistory,
  ] = useState<
    LeagueHistoryStat[]
  >([]);

  const [
    compareMode,
    setCompareMode,
  ] = useState(false);

  const [
    comparePlayerIds,
    setComparePlayerIds,
  ] = useState<number[]>([]);

  const [
    compareOpen,
    setCompareOpen,
  ] = useState(false);

  useEffect(() => {
    if (!targetDraftSlot) {
      return;
    }

    setResearchMode("season");
    setCompareMode(false);
    setComparePlayerIds([]);
    setCompareOpen(false);
  }, [
    targetDraftSlot?.teamId,
    targetDraftSlot?.positionGroup,
  ]);

  useEffect(() => {
    if (!targetDraftSlot) {
      return;
    }

    let cancelled = false;

    async function loadResearch() {
      const [
        seasonResponse,
        leagueResponse,
      ] = await Promise.allSettled([
        fetch(
          `/api/player-season-stats?season=${selectedSeason}&sport=${selectedSport}`,
          {
            cache: "no-store",
          },
        ),
        fetch(
          `/api/player-history?season=${selectedSeason}&sport=${selectedSport}`,
          {
            cache: "no-store",
          },
        ),
      ]);

      if (cancelled) {
        return;
      }

      if (
        seasonResponse.status ===
        "fulfilled"
      ) {
        try {
          const result =
            await seasonResponse.value.json();

          const rows =
            result?.playerStats ??
            result?.playerSeasonStats ??
            result?.players ??
            [];

          setSeasonStats(
            Array.isArray(rows)
              ? rows
              : [],
          );
        } catch {
          setSeasonStats([]);
        }
      } else {
        setSeasonStats([]);
      }

      if (
        leagueResponse.status ===
        "fulfilled"
      ) {
        try {
          const result =
            await leagueResponse.value.json();

          setLeagueHistory(
            Array.isArray(
              result?.playerHistory,
            )
              ? result.playerHistory
              : [],
          );
        } catch {
          setLeagueHistory([]);
        }
      } else {
        setLeagueHistory([]);
      }
    }

    void loadResearch();

    return () => {
      cancelled = true;
    };
  }, [
    targetDraftSlot?.teamId,
    selectedSeason,
    selectedSport,
  ]);

  const seasonByPlayerId =
    useMemo(() => {
      const map =
        new Map<number, any>();

      for (
        const row
        of seasonStats
      ) {
        map.set(
          Number(row.player_id),
          row,
        );
      }

      return map;
    }, [
      seasonStats,
    ]);

  const leagueByPlayerId =
    useMemo(() => {
      const map =
        new Map<
          number,
          LeagueHistoryStat
        >();

      for (
        const row
        of leagueHistory
      ) {
        map.set(
          Number(row.player_id),
          row,
        );
      }

      return map;
    }, [
      leagueHistory,
    ]);

  const filteredPlayers =
    useMemo(() => {
      if (!targetDraftSlot) {
        return [];
      }

      return players
        .filter((player) => {
          if (
            player.position_group !==
            targetDraftSlot.positionGroup
          ) {
            return false;
          }

          if (
            !showAllPlayers &&
            !isAvailabilityLoading &&
            !availablePlayerIdSet.has(
              player.id,
            )
          ) {
            return false;
          }

          if (
            getOwnerTeamForPlayer(
              player.id,
            )
          ) {
            return false;
          }

          if (
            searchTerm.trim() &&
            !player.name
              .toLowerCase()
              .includes(
                searchTerm
                  .trim()
                  .toLowerCase(),
              )
          ) {
            return false;
          }

          return true;
        })
        .sort((a, b) => {
          if (isGolf) {
            const rankA =
              a.owgr_rank;

            const rankB =
              b.owgr_rank;

            if (
              rankA == null &&
              rankB == null
            ) {
              return a.name.localeCompare(
                b.name,
              );
            }

            if (rankA == null) {
              return 1;
            }

            if (rankB == null) {
              return -1;
            }

            return (
              rankA - rankB ||
              a.name.localeCompare(
                b.name,
              )
            );
          }

          const avgA =
            playerProjections?.[a.id]
              ?.projection ??
            playerAverageMap.get(
              a.id,
            ) ??
            -999;

          const avgB =
            playerProjections?.[b.id]
              ?.projection ??
            playerAverageMap.get(
              b.id,
            ) ??
            -999;

          return (
            Number(avgB) -
              Number(avgA) ||
            a.name.localeCompare(
              b.name,
            )
          );
        });
    }, [
      targetDraftSlot,
      players,
      playerAverageMap,
      playerProjections,
      availablePlayerIdSet,
      isAvailabilityLoading,
      getOwnerTeamForPlayer,
      searchTerm,
      showAllPlayers,
      isGolf,
    ]);

  if (!targetDraftSlot) {
    return null;
  }

  async function draftPlayer(
    player: Player,
  ) {
    if (!targetDraftSlot) {
      return;
    }

    await handleAssignPlayerToTeam(
      player,
      targetDraftSlot.teamId,
    );

    setTargetDraftSlot(null);
    setSearchTerm("");
  }

  function toggleComparePlayer(
    playerId: number,
  ) {
    setComparePlayerIds(
      (previous) => {
        if (
          previous.includes(
            playerId,
          )
        ) {
          return previous.filter(
            (id) =>
              id !== playerId,
          );
        }

        if (
          previous.length >= 3
        ) {
          return previous;
        }

        return [
          ...previous,
          playerId,
        ];
      },
    );
  }

  const comparePlayers =
    comparePlayerIds
      .map((id) =>
        players.find(
          (player) =>
            player.id === id,
        ),
      )
      .filter(
        (
          player,
        ): player is Player =>
          Boolean(player),
      );

  function getCardStats(
    player: Player,
  ) {
    const season =
      seasonByPlayerId.get(
        player.id,
      );

    const league =
      leagueByPlayerId.get(
        player.id,
      );

    if (
      researchMode ===
      "league"
    ) {
      return [
        {
          label: "AVG",
          value: fmt(
            league?.avg_score,
          ),
        },
        {
          label: "BEST",
          value: fmt(
            league?.high_score,
          ),
        },
        {
          label: "WINS",
          value: intValue(
            league?.winning_lineups,
          ),
        },
        {
          label:
            isGolf
              ? "PODIUM"
              : "DRAFTED",
          value: intValue(
            isGolf
              ? league?.podium_lineups
              : league?.times_drafted,
          ),
        },
      ];
    }

    if (isGolf) {
      return [
        {
          label: "AVG",
          value: fmt(
            season?.scoring_average,
            2,
          ),
        },
        {
          label: "CUTS",
          value: pct(
            season?.cuts_made_pct,
          ),
        },
        {
          label: "BIRD/R",
          value: fmt(
            season?.birdies_per_round,
            2,
          ),
        },
        {
          label: "WINS",
          value: intValue(
            season?.wins,
          ),
        },
      ];
    }

    if (isNfl) {
      return [
        {
          label: "FP/G",
          value: fmt(
            season?.fantasy_points_per_game,
          ),
        },
        {
          label: "PASS",
          value: fmt(
            season?.passing_yards_per_game,
          ),
        },
        {
          label: "RUSH",
          value: fmt(
            season?.rushing_yards_per_game,
          ),
        },
        {
          label: "REC YD",
          value: fmt(
            season?.receiving_yards_per_game,
          ),
        },
      ];
    }

    return [
      {
        label: "FP",
        value: fmt(
          season?.fantasy_points,
        ),
      },
      {
        label: "PTS",
        value: fmt(
          season?.points,
        ),
      },
      {
        label: "REB",
        value: fmt(
          season?.rebounds,
        ),
      },
      {
        label: "AST",
        value: fmt(
          season?.assists,
        ),
      },
    ];
  }

  return (
    <div
      className={`mobile-modal-safe slot-draft-overlay fixed inset-0 z-50 flex items-end justify-center bg-slate-950/70 px-3 py-4 backdrop-blur-sm sm:items-center ${
        hidden
          ? "slot-draft-overlay--hidden"
          : ""
      }`}
      aria-hidden={hidden}
      onClick={() => {
        if (!hidden) {
          setTargetDraftSlot(
            null,
          );
        }
      }}
    >
      <section
        className="mobile-modal-panel-safe slot-draft-modal flex max-h-[88dvh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl border shadow-2xl"
        onClick={(event) =>
          event.stopPropagation()
        }
      >
        <header className="slot-draft-header">
          <div className="min-w-0">
            <div className="slot-draft-kicker">
              Draft to roster spot
            </div>

            <h2>
              {
                targetDraftSlot.teamName
              }
              <span>
                {
                  targetDraftSlot.positionGroup
                }
              </span>
            </h2>

            <p>
              Choose an available{" "}
              {
                targetDraftSlot.positionGroup
              }.
            </p>
          </div>

          <button
            type="button"
            onClick={() =>
              setTargetDraftSlot(
                null,
              )
            }
            className="slot-draft-close"
            aria-label="Close draft modal"
          >
            ×
          </button>
        </header>

        <div className="border-b border-slate-700 bg-slate-950/95 px-4 pt-3">
          <div className="grid grid-cols-2 gap-1 rounded-xl bg-slate-900 p-1">
            <button
              type="button"
              onClick={() =>
                setResearchMode(
                  "season",
                )
              }
              className={`rounded-lg px-3 py-2 text-xs font-black transition ${
                researchMode ===
                "season"
                  ? isGolf
                    ? "bg-emerald-600 text-white"
                    : "bg-sky-600 text-white"
                  : "text-slate-400"
              }`}
            >
              Pro Season
            </button>

            <button
              type="button"
              onClick={() =>
                setResearchMode(
                  "league",
                )
              }
              className={`rounded-lg px-3 py-2 text-xs font-black transition ${
                researchMode ===
                "league"
                  ? isGolf
                    ? "bg-emerald-600 text-white"
                    : "bg-sky-600 text-white"
                  : "text-slate-400"
              }`}
            >
              111 League
            </button>
          </div>
        </div>

        <div className="slot-draft-search">
          <div className="slot-draft-search-heading">
            <label htmlFor="slot-player-search">
              Search players
            </label>

            <div
              className="inline-flex shrink-0 rounded-full border border-slate-600 bg-slate-800 p-1"
              role="group"
              aria-label="Player availability"
            >
              <button
                type="button"
                onClick={() =>
                  setShowAllPlayers(
                    false,
                  )
                }
                aria-pressed={
                  !showAllPlayers
                }
                className={`rounded-full px-3 py-1.5 text-xs font-bold transition ${
                  !showAllPlayers
                    ? "bg-sky-600 text-white shadow-sm"
                    : "text-slate-300"
                }`}
              >
                On This Slate
              </button>

              <button
                type="button"
                onClick={() =>
                  setShowAllPlayers(
                    true,
                  )
                }
                aria-pressed={
                  showAllPlayers
                }
                className={`rounded-full px-3 py-1.5 text-xs font-bold transition ${
                  showAllPlayers
                    ? "bg-sky-600 text-white shadow-sm"
                    : "text-slate-300"
                }`}
              >
                All Players
              </button>
            </div>
          </div>

          <input
            id="slot-player-search"
            type="text"
            value={searchTerm}
            onChange={(event) =>
              setSearchTerm(
                event.target.value,
              )
            }
            placeholder={`Search ${targetDraftSlot.positionGroup} players...`}
            autoFocus
          />
        </div>

        {compareMode ? (
          <div className="border-b border-slate-700 bg-slate-950 px-4 py-2 text-xs text-slate-300">
            <div className="flex items-center justify-between gap-3">
              <span>
                Select 2–3 players
                to compare.
              </span>

              <button
                type="button"
                onClick={() => {
                  setCompareMode(
                    false,
                  );
                  setComparePlayerIds(
                    [],
                  );
                }}
                className="font-bold text-slate-300"
              >
                Cancel
              </button>
            </div>
          </div>
        ) : null}

        <div className="slot-draft-results min-h-0 flex-1 overflow-y-auto p-4 pb-28 sm:p-5">
          {isAvailabilityLoading ? (
            <div className="slot-draft-empty">
              <div aria-hidden="true">
                {isGolf
                  ? "⛳"
                  : "🏀"}
              </div>

              <strong>
                Loading available players
              </strong>
            </div>
          ) : filteredPlayers.length ===
            0 ? (
            <div className="slot-draft-empty">
              <div aria-hidden="true">
                📅
              </div>

              <strong>
                No players available yet
              </strong>
            </div>
          ) : (
            <div className="space-y-3">
              {filteredPlayers.map(
                (player) => {
                  const selected =
                    comparePlayerIds.includes(
                      player.id,
                    );

                  const stats =
                    getCardStats(
                      player,
                    );

                  return (
                    <article
                      key={player.id}
                      className={`rounded-2xl border bg-slate-900/90 p-3 transition ${
                        selected
                          ? isGolf
                            ? "border-emerald-400 ring-2 ring-emerald-400/40"
                            : "border-sky-400 ring-2 ring-sky-400/40"
                          : "border-slate-700"
                      }`}
                    >
                      <div className="flex items-start gap-3">
                        <button
                          type="button"
                          onClick={() => {
                            if (
                              compareMode
                            ) {
                              toggleComparePlayer(
                                player.id,
                              );
                              return;
                            }

                            onInspectPlayer(
                              player,
                            );
                          }}
                          className="flex min-w-0 flex-1 items-center gap-3 text-left"
                        >
                          <PlayerHeadshot
                            nbaPlayerId={
                              player.nba_player_id
                            }
                            nflPlayerId={
                              player.nfl_player_id
                            }
                            espnGolfPlayerId={
                              player.espn_player_id
                            }
                            imageUrl={
                              player.headshot_url
                            }
                            playerName={
                              player.name
                            }
                            size="md"
                          />

                          <div className="min-w-0">
                            <div className="truncate text-base font-black text-white">
                              {
                                player.name
                              }
                            </div>

                            <div className="mt-0.5 text-xs text-slate-400">
                              {
                                player.position_group
                              }
                              {isGolf
                                ? ` · OWGR ${
                                    player.owgr_rank
                                      ? `#${player.owgr_rank}`
                                      : "—"
                                  }`
                                : ""}
                            </div>

                            <div
                              className={`mt-1 text-[11px] font-bold ${
                                isGolf
                                  ? "text-emerald-300"
                                  : "text-sky-300"
                              }`}
                            >
                              {compareMode
                                ? selected
                                  ? "✓ Selected"
                                  : "Tap to compare"
                                : "View player stats"}
                            </div>
                          </div>
                        </button>

                        <button
                          type="button"
                          onClick={() =>
                            void draftPlayer(
                              player,
                            )
                          }
                          disabled={
                            isAssigningPlayer ||
                            isSaving
                          }
                          className="shrink-0 rounded-full border border-emerald-700 bg-emerald-950/70 px-4 py-2 text-xs font-black text-emerald-300 disabled:opacity-50"
                        >
                          {isAssigningPlayer ||
                          isSaving
                            ? "Saving…"
                            : "Draft"}
                        </button>
                      </div>

                      <button
                        type="button"
                        onClick={() => {
                          if (
                            compareMode
                          ) {
                            toggleComparePlayer(
                              player.id,
                            );
                          } else {
                            onInspectPlayer(
                              player,
                            );
                          }
                        }}
                        className="mt-3 grid w-full grid-cols-4 gap-1 border-t border-slate-700/70 pt-2"
                      >
                        {stats.map(
                          (
                            stat,
                            index,
                          ) => (
                            <div
                              key={`${stat.label}-${index}`}
                              className="rounded-lg bg-slate-950/55 px-1 py-1.5 text-center"
                            >
                              <strong className="block text-[13px] font-black text-white">
                                {
                                  stat.value
                                }
                              </strong>

                              <span className="mt-0.5 block text-[9px] font-bold uppercase text-slate-400">
                                {
                                  stat.label
                                }
                              </span>
                            </div>
                          ),
                        )}
                      </button>
                    </article>
                  );
                },
              )}
            </div>
          )}
        </div>

        <div className="absolute inset-x-0 bottom-0 border-t border-slate-700 bg-slate-950/95 p-3 backdrop-blur">
          {!compareMode ? (
            <button
              type="button"
              data-floating-compare="true"
              onClick={() =>
                setCompareMode(true)
              }
              className="w-full rounded-xl border border-sky-600 bg-sky-950 px-4 py-3 text-sm font-black text-sky-200"
            >
              ⇄ Compare Players
            </button>
          ) : (
            <button
              type="button"
              onClick={() =>
                setCompareOpen(true)
              }
              disabled={
                comparePlayers.length <
                2
              }
              className="w-full rounded-xl bg-sky-600 px-4 py-3 text-sm font-black text-white disabled:cursor-not-allowed disabled:opacity-40"
            >
              Compare{" "}
              {
                comparePlayers.length
              }{" "}
              Players
            </button>
          )}
        </div>

        {compareOpen &&
        comparePlayers.length >=
          2 ? (
          <div
            className="absolute inset-0 z-20 flex items-end bg-slate-950/80 p-3 backdrop-blur-sm sm:items-center"
            onClick={() =>
              setCompareOpen(false)
            }
          >
            <section
              className="max-h-[80dvh] w-full overflow-y-auto rounded-3xl border border-slate-700 bg-slate-950 p-4 shadow-2xl"
              onClick={(event) =>
                event.stopPropagation()
              }
            >
              <div className="flex items-center justify-between">
                <div>
                  <div className="text-xs font-black uppercase tracking-[0.18em] text-sky-300">
                    Player Comparison
                  </div>

                  <h3 className="mt-1 text-xl font-black text-white">
                    Side by side
                  </h3>
                </div>

                <button
                  type="button"
                  onClick={() =>
                    setCompareOpen(
                      false,
                    )
                  }
                  className="rounded-full border border-slate-700 px-3 py-2 text-white"
                >
                  ×
                </button>
              </div>

              <div
                className="mt-4 grid gap-2"
                style={{
                  gridTemplateColumns:
                    `repeat(${comparePlayers.length}, minmax(0, 1fr))`,
                }}
              >
                {comparePlayers.map(
                  (player) => (
                    <div
                      key={
                        player.id
                      }
                      className="rounded-2xl border border-slate-700 bg-slate-900 p-3 text-center"
                    >
                      <PlayerHeadshot
                        nbaPlayerId={
                          player.nba_player_id
                        }
                        nflPlayerId={
                          player.nfl_player_id
                        }
                        espnGolfPlayerId={
                          player.espn_player_id
                        }
                        imageUrl={
                          player.headshot_url
                        }
                        playerName={
                          player.name
                        }
                        size="md"
                        className="mx-auto"
                      />

                      <div className="mt-2 truncate text-sm font-black text-white">
                        {
                          player.name
                        }
                      </div>
                    </div>
                  ),
                )}
              </div>

              <div className="mt-3 space-y-2">
                {[
                  0,
                  1,
                  2,
                  3,
                ].map(
                  (statIndex) => (
                    <div
                      key={
                        statIndex
                      }
                      className="grid items-stretch gap-2"
                      style={{
                        gridTemplateColumns:
                          `repeat(${comparePlayers.length}, minmax(0, 1fr))`,
                      }}
                    >
                      {comparePlayers.map(
                        (
                          player,
                        ) => {
                          const stat =
                            getCardStats(
                              player,
                            )[
                              statIndex
                            ];

                          return (
                            <div
                              key={`${player.id}-${statIndex}`}
                              className="rounded-xl bg-slate-900 p-2 text-center"
                            >
                              <div className="text-lg font-black text-white">
                                {
                                  stat
                                    ?.value ??
                                  "—"
                                }
                              </div>

                              <div className="text-[9px] font-black uppercase text-slate-400">
                                {
                                  stat
                                    ?.label ??
                                  ""
                                }
                              </div>
                            </div>
                          );
                        },
                      )}
                    </div>
                  ),
                )}
              </div>

              <button
                type="button"
                onClick={() =>
                  setCompareOpen(
                    false,
                  )
                }
                className="mt-4 w-full rounded-xl border border-slate-700 px-4 py-3 font-bold text-white"
              >
                Back to players
              </button>
            </section>
          </div>
        ) : null}
      </section>
    </div>
  );
}
